{
  "manifest_version": 3,
  "name": "Claude Artifact HTML Downloader",
  "version": "1.2.0",
  "description": "Downloads the HTML of the Claude artifact opened in the current tab.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://*.claudeusercontent.com/*"],
  "action": {
    "default_title": "Download artifact HTML",
    "default_popup": "popup.html"
  }
}
